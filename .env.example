# Replace YOUR_POSTGRES_PASSWORD with your real local postgres password.
# If you use the included docker-compose.yml, use port 5433 and password "password".
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/vku_booking
DATABASE_SSL=false
API_PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Vite exposes only variables prefixed with VITE_ to the browser.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
